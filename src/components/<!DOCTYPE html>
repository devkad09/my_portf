<script>
window.formgridHcaptcha = {
    getToken: function (form) {
        if (!form) return '';
        var input = form.querySelector('[name="h-captcha-response"]');
        return (input && input.value ? input.value : '').trim();
    },
    reset: function () {
        if (typeof hcaptcha === 'undefined' || !hcaptcha.reset) return;
        try {
            hcaptcha.reset();
        } catch (resetErr) {}
    },
    applyToParams: function (form, params) {
        params.delete('g-recaptcha-response');
        params.delete('cf-turnstile-response');
        params.delete('turnstile-token');
        params.delete('h-captcha-response');
        var token = this.getToken(form);
        if (token) {
            params.set('h-captcha-response', token);
        }
        return token;
    }
};
</script>

<script>
(function () {
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('support-form');
        if (!form) return;

        var successEl = document.getElementById('support-success');
        var errorEl = document.getElementById('support-error');
        var submitBtn = document.getElementById('support-submit');

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (errorEl) {
                errorEl.classList.add('hidden');
                errorEl.textContent = '';
            }
            if (successEl) successEl.classList.add('hidden');

            var action = form.getAttribute('action');
            if (!action) {
                if (errorEl) {
                    errorEl.textContent = 'Form action is missing. Please refresh the page or email allen@formgrid.dev.';
                    errorEl.classList.remove('hidden');
                }
                return;
            }

            var params = new URLSearchParams(new FormData(form));
            var hcaptchaToken = window.formgridHcaptcha.applyToParams(form, params);
            if (!hcaptchaToken) {
                if (errorEl) {
                    errorEl.textContent = 'Please complete the verification check below.';
                    errorEl.classList.remove('hidden');
                }
                window.formgridHcaptcha.reset();
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Sending…';
            }

            fetch(action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'application/json'
                },
                body: params.toString(),
                credentials: 'same-origin',
                redirect: 'manual'
            }).then(function (res) {
                if (res.type === 'opaqueredirect' || res.status === 0 || (res.status >= 300 && res.status < 400)) {
                    form.reset();
                    window.formgridHcaptcha.reset();
                    if (successEl) successEl.classList.remove('hidden');
                    return;
                }
                if (res.ok) {
                    form.reset();
                    window.formgridHcaptcha.reset();
                    if (successEl) successEl.classList.remove('hidden');
                    return;
                }
                return res.json().then(function (data) {
                    var msg = (data && data.message)
                        ? data.message
                        : 'Something went wrong. Please try again or email allen@formgrid.dev directly.';
                    throw new Error(msg);
                }).catch(function () {
                    throw new Error('Something went wrong. Please try again or email allen@formgrid.dev directly.');
                });
            }).catch(function (err) {
                window.formgridHcaptcha.reset();
                if (errorEl) {
                    errorEl.textContent = err.message || 'Something went wrong. Please try again or email allen@formgrid.dev directly.';
                    errorEl.classList.remove('hidden');
                }
            }).finally(function () {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit';
                }
            });
        });
    });
})();
</script>



